{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
     "paths": {
      "@modules/*": ["modules/*"],
      "@shared/*": ["shared/*"]
    },
  }
}